# ---------------------------------------------------------------------------
# Environment variables for local development.
#
# Copy this file to `.env.local` and fill in the values you need:
#
#   cp .env.example .env.local
#
# The devcontainer bootstrap script (scripts/devcontainer-bootstrap.sh) writes
# a ready-to-use `.env.local` for the local Supabase + Stellar quickstart
# stack, so you normally do not need to edit this file by hand when working
# inside the devcontainer.
# ---------------------------------------------------------------------------

# --- Supabase (local stack) -------------------------------------------------
# Defaults exposed by `supabase start` inside the devcontainer.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stellar (local quickstart network) -------------------------------------
# `stellar/quickstart --local --enable rpc` exposes RPC, Horizon and Friendbot
# on the same host. The bootstrap script deploys the test attestation contract
# and fills in the contract id below.
NEXT_PUBLIC_STELLAR_NETWORK=local
NEXT_PUBLIC_STELLAR_RPC_URL=http://127.0.0.1:8000/soroban/rpc
NEXT_PUBLIC_STELLAR_HORIZON_URL=http://127.0.0.1:8000
NEXT_PUBLIC_STELLAR_FRIENDBOT_URL=http://127.0.0.1:8000/friendbot
NEXT_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Standalone Network ; February 2017
NEXT_PUBLIC_ATTESTATION_CONTRACT_ID=

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
